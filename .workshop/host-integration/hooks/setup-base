#!/bin/bash
set -euo pipefail

# The dev workshop builds one static host/guest binary; the runtime SDK needs no compiler.
if [ ! -x "$SDK/bin/workshop-desktop" ]; then
  echo 'Build workshop-desktop first: workshop run dev -- build; then launch or refresh apps.' >&2
  exit 1
fi

# Give the guest user search access to both mounts. Workshop can otherwise
# create this shared parent as root with mode 0700 when connecting the plugs.
install -d -m 0711 /mnt/workshop-host

# Audio: install the guest PulseAudio compatibility service and wrapper.
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends pipewire-pulse dbus-user-session wayland-utils libglib2.0-bin

# The host owns the graph and session manager. Only our compatibility server
# should listen on the guest Pulse socket, including after socket activation.
systemctl --global mask pipewire.service pipewire.socket \
  pipewire-pulse.service pipewire-pulse.socket wireplumber.service

install -m 0644 "$SDK/systemd/workshop-pipewire-pulse.service" \
  /etc/systemd/user/workshop-pipewire-pulse.service
install -m 0755 "$SDK/bin/workshop-host-audio" /usr/local/bin/workshop-host-audio

# The guest launcher starts the service on demand.
systemctl --global disable workshop-pipewire-pulse.service
rm -f /etc/profile.d/workshop-host-audio.sh

# Host URL opening: divert the packaged guest opener.
# Cover PATH and absolute-path callers. Preserve xdg-utils' utility if present,
# and divert future package installs too; the wrapper uses gdbus.
dpkg-divert --local --rename --add /usr/bin/xdg-open
install -m 0755 "$SDK/bin/workshop-desktop" /usr/local/bin/workshop-desktop
install -m 0755 "$SDK/bin/xdg-open" /usr/bin/xdg-open
